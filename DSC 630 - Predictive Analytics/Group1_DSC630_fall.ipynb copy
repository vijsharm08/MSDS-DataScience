    "#group cabins by fare range and pclass\n",
    "\n",
    "test['FareBin'] = pd.qcut(test['Fare'], 3)  # bins\n",
    "\n",
    "pivot = test.pivot_table(\n",
    "    index=['FareBin', 'Pclass'],\n",
    "    columns='Cabin',\n",
    "    values='Fare',\n",
    "    aggfunc='count',\n",
    "    fill_value=0,\n",
    "    observed=False)\n",
    "\n",
    "pivot"
   ]
  },
  {
   "cell_type": "code",
